# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://clanministry.org

# Payment gateway (optional - for donations)
# Set PAYMENT_PROVIDER to "stripe" (recommended) or "paystack" to enable live
# payments, or leave blank/"test" for dev mode (donations recorded directly).
# Stripe accepts donations in USD, GBP, NGN, EUR, CAD and GHS.
PAYMENT_PROVIDER=stripe
# Stripe (recommended). Set STRIPE_SECRET_KEY (sk_test_... / sk_live_...) and
# STRIPE_WEBHOOK_SECRET (whsec_..., from the Stripe dashboard -> Webhooks) and
# point the webhook at https://<your-domain>/api/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paystack (alternative). Supported currencies: USD, NGN, GHS, ZAR, KES, XOF.
# PAYMENT_PROVIDER_SECRET is the Paystack secret key.
PAYMENT_PROVIDER_SECRET=

# Maintenance mode (optional)
# Set MAINTENANCE_MODE=true to take the public site offline and show the
# maintenance page (admin dashboard still works, so you can turn it back on).
# You can also toggle maintenance from Admin -> Settings.
MAINTENANCE_MODE=false

# Email delivery (required for the newsletter welcome/confirmation emails)
# EMAIL_PROVIDER is one of: resend | sendgrid | smtp
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
# Optional friendly sender name; defaults to "Christian Life Altar Network (CLAN)"
EMAIL_FROM_NAME=
# SMTP settings (only used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set SMTP_SECURE=true when using port 465 (implicit TLS)
SMTP_SECURE=false
